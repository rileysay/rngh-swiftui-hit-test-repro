{
  "name": "rngh-swiftui-hit-test-repro",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node scripts/verify-setup.cjs",
    "start": "expo start --dev-client",
    "ios": "expo run:ios --configuration Debug",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-setup.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "expo": "57.0.20",
    "expo-build-properties": "57.0.17",
    "expo-dev-client": "57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.17",
    "babel-preset-expo": "57.0.10",
    "metro": "0.84.5",
    "metro-runtime": "0.84.5",
    "patch-package": "8.0.1",
    "typescript": "6.0.3"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": ["react-native-gesture-handler", "react-native-reanimated", "react-native-worklets"]
      }
    },
    "install": {
      "exclude": ["react-native-gesture-handler", "react-native-reanimated", "react-native-worklets"]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "overrides": {
    "react-native-worklets": "$react-native-worklets"
  }
}
